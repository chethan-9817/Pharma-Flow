rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email', 'displayName', 'karmaPoints', 'scratchCardsCount', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.email is string &&
             data.displayName is string &&
             data.karmaPoints is int && data.karmaPoints >= 0 &&
             data.scratchCardsCount is int && data.scratchCardsCount >= 0;
    }

    function isValidDonation(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'medicineName', 'ngoId', 'ngoName', 'status', 'karmaPointsAwarded', 'createdAt']) &&
             data.userId is string && data.userId == userId &&
             data.id is string &&
             data.medicineName is string && data.medicineName.size() > 0 &&
             data.ngoId is string &&
             data.ngoName is string &&
             data.status in ['PENDING', 'ACCEPTED', 'PICKUP_SCHEDULED', 'VERIFIED', 'COMPLETED'] &&
             data.karmaPointsAwarded is int && data.karmaPointsAwarded >= 0;
    }

    function isValidListing(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'medicineName', 'batchNumber', 'expiryDate', 'status', 'createdAt']) &&
             data.userId is string && data.userId == userId &&
             data.id is string &&
             data.medicineName is string &&
             data.status in ['PENDING_VERIFICATION', 'ACTIVE', 'SOLD', 'RETURNED'];
    }

    function isValidOrder(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'itemCount', 'total', 'status', 'createdAt']) &&
             data.userId is string && data.userId == userId &&
             data.id is string &&
             data.itemCount is int && data.itemCount > 0 &&
             data.status in ['PLACED', 'DISPATCHED', 'DELIVERED', 'CANCELLED'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;

      match /donations/{donationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDonation(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidDonation(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /listings/{listingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidListing(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidListing(request.resource.data, userId);
        allow delete: if isOwner(userId);
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidOrder(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidOrder(request.resource.data, userId);
        allow delete: if false;
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
